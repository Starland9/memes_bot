# Clé API DeepSeek (obligatoire)
DEEPSEEK_API_KEY=sk-...

# Bot Telegram : token donné par @BotFather, chat_id du canal/groupe
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=-1001234567890

# API memegen utilisée pour générer les images
MEMEGEN_BASE_URL=https://api.memegen.link

# État SQLite + images de dry-run (en Docker/Dokploy : ne pas définir, l'image fixe /data)
DATA_DIR=./data

# Sécurité : 1 = génère sans publier
DRY_RUN=1

# Réglages optionnels
MAX_AGE_HOURS=8
MAX_NEWS_ITEMS=40
DEEPSEEK_MODEL=deepseek-flash
REQUEST_TIMEOUT=30
