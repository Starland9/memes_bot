# Clé API DeepSeek (obligatoire)
DEEPSEEK_API_KEY=sk-...

# Bot Telegram : token donné par @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Optionnel : canal/groupe supplémentaire. Les abonnés s'inscrivent avec /start.
TELEGRAM_CHAT_ID=-1001234567890

# API memegen utilisée pour générer les images
MEMEGEN_BASE_URL=https://api.memegen.link

# État SQLite + images de dry-run (en Docker/Dokploy : ne pas définir, l'image fixe /data)
DATA_DIR=./data

# Sécurité : 1 = génère sans publier
DRY_RUN=1

# Réglages optionnels
MAX_AGE_HOURS=8
MAX_NEWS_ITEMS=40
DEEPSEEK_MODEL=deepseek-flash
REQUEST_TIMEOUT=60

# Statut WhatsApp via une passerelle OpenWA (optionnel : décommenter les variables)
# OPENWA_BASE_URL=http://127.0.0.1:2785
# OPENWA_API_KEY=owa_k1_...
# OPENWA_SESSION_ID=00000000-0000-0000-0000-000000000000
# JIDs destinataires manuels, séparés par des virgules.
# Obligatoire avec l'engine Baileys, à laisser vide avec whatsapp-web.js.
# OPENWA_STATUS_RECIPIENTS=123456789@c.us
# 1 = ajoute les contacts du carnet d'adresses mis en cache par --sync-contacts
# OPENWA_STATUS_USE_CONTACTS=1
# 1 = ne garde que les contacts avec qui une discussion individuelle existe
# OPENWA_STATUS_CHATTED_ONLY=1
# Ne garde que les discussions actives depuis N jours (0 = pas de limite)
# OPENWA_STATUS_CHAT_DAYS=90

# Chaîne WhatsApp (newsletter) : id de la chaîne où poster le meme.
# Elle doit déjà exister ; l'engine doit être Baileys (ENGINE_TYPE=baileys),
# whatsapp-web.js refuse les images vers une chaîne (501).
# OPENWA_CHANNEL_ID=120363000000000000@newsletter

# Cibles de publication, séparées par des virgules : telegram, status, channel.
# Vide = telegram, plus status si OpenWA est configuré.
# PUBLISH_TARGETS=channel
